# Supabase (required for production on Vercel)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Admin account password for seed script + local FS admin login
ZAMIN_ADMIN_PASSWORD=change-me
# Optional aliases
# ADMIN_PASSWORD=change-me
# ADMIN_TOKEN=

# Extra admin logins shown in cabinet (comma-separated). Built-in: zamin, admin
# NEXT_PUBLIC_ADMIN_LOGINS=

# Sentry (optional — error tracking)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# Telegram order notifications (optional)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
